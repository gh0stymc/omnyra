# Development OAuth client IDs (never commit the real .env)
OMNYRA_GOOGLE_CLIENT_ID=
# Google "Desktop app" client secret is documented by Google as non-confidential (see docs/ARCHITECTURE.md R3)
OMNYRA_GOOGLE_CLIENT_SECRET=
# Twitch app registered as a *Public* client (device code flow, no secret)
OMNYRA_TWITCH_CLIENT_ID=
# Instagram and TikTok (docs/AUTH_STRATEGY.md): only the public IDs go here; the secrets live in the token broker (broker/)
OMNYRA_BROKER_URL=
OMNYRA_INSTAGRAM_CLIENT_ID=
OMNYRA_TIKTOK_CLIENT_KEY=
